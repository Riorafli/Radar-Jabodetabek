# Copy to .env for local runs (never commit .env). In GitHub these go to
# Settings > Secrets and variables > Actions.

# Supabase > Connect > Session pooler (NOT the direct connection; IPv6 issue)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# LLM (at least one). Gemini: https://aistudio.google.com/apikey  Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# YouTube Data API v3 key (Google Cloud Console, no billing needed)
YOUTUBE_API_KEY=

# Optional: Reddit app-only OAuth (https://www.reddit.com/prefs/apps, type "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Telegram notifications from pipeline/notify.py (same token as the bot Worker)
TELEGRAM_BOT_TOKEN=
# Only for scripts/set_webhook.py (run once after deploying bot/)
WORKER_URL=https://radar-jabodetabek-bot.YOURNAME.workers.dev
WEBHOOK_SECRET=

# Contact used in the User-Agent for Nominatim/Overpass (their usage policy asks for one)
CONTACT_EMAIL=
